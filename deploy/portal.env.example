# Copy to /etc/meeting-portal/portal.env, owned root, readable by service only.
# Never commit the filled file. Values below are examples, not live credentials.
DATABASE_URL=postgresql://portal:CHANGE_ME@127.0.0.1:5432/portal
PUBLIC_ORIGIN=https://peregovornii.ugmkstroy.ru
PROXY_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AD_REALM=EKATCITY.EKAT-CITY.COM
AD_HOST=REPLACE_WITH_DOMAIN_CONTROLLER_FQDN
AD_CA_FILE=/etc/meeting-portal/ad-ca.pem
AD_BIND_DN=REPLACE_WITH_READ_ONLY_SERVICE_ACCOUNT_DN
AD_BIND_PASSWORD=REPLACE_WITH_SERVICE_ACCOUNT_PASSWORD
AD_BASE_DN=DC=ekatcity,DC=ekat-city,DC=com
# Use exact DNs from AD; CN and OU cannot be inferred from short names.
AD_ADMIN_GROUP_DN=CN=bron,REPLACE_WITH_ACTUAL_GROUP_OU,DC=ekatcity,DC=ekat-city,DC=com
AD_DELEGATE_GROUP_DN=CN=secretary,REPLACE_WITH_ACTUAL_GROUP_OU,DC=ekatcity,DC=ekat-city,DC=com
