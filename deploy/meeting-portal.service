[Unit]
Description=UGMK meeting room portal
After=network.target postgresql.service
Requires=postgresql.service
[Service]
Type=simple
User=meeting-portal
Group=www-data
WorkingDirectory=/opt/meeting-portal
EnvironmentFile=/etc/meeting-portal/portal.env
RuntimeDirectory=meeting-portal
RuntimeDirectoryMode=0750
UMask=0007
ExecStart=/opt/meeting-portal/.venv/bin/uvicorn server.app:app --uds /run/meeting-portal/app.sock --workers 2 --no-proxy-headers
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/meeting-portal
[Install]
WantedBy=multi-user.target
